# Copy to env/secrets.env (git-ignored). NEVER commit the real key. Get it from Ken by DM.
# The Huawei-issued key is an OpenRouter key (prefix sk-or-v1-), $40 hard cap, expires 2026-09-26.
API_BASE=https://openrouter.ai/api/v1
API_KEY=sk-or-v1-...
# Day-to-day: cheap open models (about 3 cents per run of the example).
MODEL_NAME=qwen/qwen3-coder-next
# Different model family on purpose. Reasoning model: needs max_tokens >= 2000.
REVIEWER_MODEL=moonshotai/kimi-k2.7-code
# For the demo and final runs (about 50 cents to a dollar per function): swap to these, or use /models in the console.
# MODEL_NAME=anthropic/claude-sonnet-5
# REVIEWER_MODEL=anthropic/claude-opus-5

# A function that runs out of tries on the models above moves up to these, in order. Only the failures pay for them.
ESCALATE_MODELS=anthropic/claude-sonnet-5,anthropic/claude-opus-5
