{
  "schema_version": 1,
  "profile": "flow-selftest",
  "run_source": [
    "python",
    "runners/source.py"
  ],
  "run_target": [
    "python",
    "runners/target.py"
  ],
  "build_target": [
    "rustc",
    "-O",
    "harness/main.rs",
    "-o",
    "flow_target.exe"
  ],
  "verify_seconds": 120,
  "frozen": [
    "profile.json",
    "gen_cases.py",
    "chunks/*",
    "contracts/*",
    "legacy/*",
    "harness/*",
    "runners/*",
    "cases.jsonl",
    "locked/*"
  ],
  "oracle_paths": [
    "legacy",
    "cases.jsonl",
    "locked",
    "gen_cases.py"
  ],
  "forbid_patterns": [
    {
      "regex": "\\bunsafe\\b",
      "why": "application unsafe is not allowed in the Rust core"
    },
    {
      "regex": "\\b(todo|unimplemented)!",
      "why": "stub macro"
    }
  ],
  "locked_cases": "locked/cases.jsonl"
}
